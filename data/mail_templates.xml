    <!-- ===================================================== -->
        <!-- VALIDATION Solde -->
        <!-- ===================================================== -->

        <record id="mail_template_demande_conge_to_solde" model="mail.template">
    <field name="name">Demande Congé - Validation du solde</field>
    <field name="model_id" ref="model_ar_demande_conge"/>
    <field name="subject">[Demande Congé] {{ object.name }} - Validation du solde requise</field>
    <field name="email_from">Demande RH &lt;AR-ARMaroc@araymond.com&gt;</field>
    <field name="email_to"></field>
    <field name="body_html" type="html">
        <div>
            <p>Bonjour,</p>
            <p>Une demande de congé nécessite votre validation du solde.</p>

            <p><b>Référence :</b> <t t-out="object.name"/></p>
            <p><b>Demandeur :</b> <t t-out="object.demandeur_id.name"/></p>
            <p><b>Département :</b> <t t-out="object.department_id.name or ''"/></p>
            <p><b>Fonction :</b> <t t-out="object.fonction or ''"/></p>
            <p><b>Date début :</b> <span t-field="object.date_debut"/></p>
            <p><b>Date fin :</b> <span t-field="object.date_fin"/></p>

            <t t-if="object.situation">
                <p><b>Motif :</b> <t t-out="dict(object._fields['situation'].selection).get(object.situation)"/></p>
            </t>

            <t t-if="object.commentaire">
                <p><b>Commentaire général :</b> <t t-out="object.commentaire"/></p>
            </t>

            <t t-if="object.compteur_conge">
    <p><b>Compteur de congé :</b> <t t-out="object.compteur_conge"/></p>
</t>

<t t-if="object.motif_refus">
    <p><b>Motif de refus :</b> <t t-out="object.motif_refus"/></p>
</t>

            <t t-set="base_url" t-value="object.get_base_url()"/>
            <div style="margin: 16px 0px;">
                <a t-attf-href="{{ base_url }}/web#id={{ object.id }}&amp;model=ar.demande.conge&amp;view_type=form"
                   style="background-color:#1481f4;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;font-size:13px;">
                    Ouvrir la demande
                </a>
            </div>
        </div>
    </field>
</record>

