                    </t>

                    <t t-if="object.commentaire">
                        <p><b>Commentaire général :</b> <t t-out="object.commentaire"/></p>
                    </t>

                    <t t-if="object.compteur_conge">
    <p><b>Compteur de congé :</b> <t t-out="object.compteur_conge"/></p>
</t>

<t t-if="object.motif_refus">
    <p><b>Motif de refus :</b> <t t-out="object.motif_refus"/></p>
</t>

                    <t t-set="base_url" t-value="object.get_base_url()"/>
